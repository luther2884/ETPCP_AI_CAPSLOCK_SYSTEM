{"nodes": [{"id": "claude_three_layer_architecture", "label": "3-Layer Architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLMs are probabilistic while business logic is deterministic and requires consistency, so separating concerns maximizes reliability. If the agent does everything itself, errors compound (90% accuracy per step = 59% success over 5 steps); pushing complexity into deterministic code lets the agent focus purely on decision-making."}, {"id": "claude_layer_1_directive", "label": "Layer 1: Directive", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_layer_2_orchestration", "label": "Layer 2: Orchestration", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_layer_3_execution", "label": "Layer 3: Execution", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_operating_principles", "label": "Operating Principles", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three principles keep the agent reliable: check execution/ for existing tools before writing new scripts; self-anneal by fixing and testing broken scripts (checking with the user first if paid tokens/credits are involved) and recording what was learned; and treat directives as living documents updated (never overwritten without asking) as constraints and better approaches are discovered."}, {"id": "claude_self_annealing_loop", "label": "Self-Annealing Loop", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors are treated as learning opportunities: fix the issue, update the tool, test it, update the directive to include the new flow -- so the system gets stronger over time rather than repeating the same failure."}, {"id": "claude_file_organization", "label": "File Organization", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliverables (Google Sheets/Slides/cloud outputs) are kept separate from intermediates (local processing files) so the user always accesses results through cloud services, while local files remain disposable and regeneratable."}, {"id": "claude_directives_dir", "label": "directives/ Directory", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_execution_dir", "label": "execution/ Directory", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_tmp_dir", "label": ".tmp/ Directory", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_env_file", "label": ".env File", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_google_oauth_credentials", "label": "Google OAuth Credentials (credentials.json, token.json)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_layer_1_directive", "target": 