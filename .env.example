# Environment Variables Template
# Copy this file to .env and fill in sensitive credentials
# .env is gitignored - never commit real secrets.

# Database - leave commented out locally (config/database.php falls back to
# XAMPP's localhost/root/no password). On the host, set all four.
# DB_HOST=localhost
# DB_NAME=techworld_ecommerce
# DB_USER=root
# DB_PASS=

# Xendit Payment Gateway (https://dashboard.xendit.co/settings/developers#api-keys)
# Use your TEST mode secret key during development (starts with xnd_development_...).
# Never put the secret key in frontend code - it is only ever read server-side.
XENDIT_SECRET_KEY=

# From https://dashboard.xendit.co/settings/developers#webhooks - the "Verification Token"
# for your webhook. Used to verify the x-callback-token header on incoming webhooks.
XENDIT_WEBHOOK_TOKEN=

# Gemini API (AI Builder) - create a key at https://aistudio.google.com/app/apikey
# Never put this in frontend/JS code - config/ai_config.php only reads it server-side.
# See config/ai_config.php for setup notes and how to change the model.
#
# This is a TEMPLATE file and it is committed to git: never put a real key here.
# The real one belongs in .env, which is gitignored.
#
# config/gemini_client.php sends the key as ?key=<value>, which is the AI Studio
# API key format (these start with "AIza"). A Google Cloud OAuth credential
# (starting "AQ.") will be rejected with HTTP 401 ACCESS_TOKEN_TYPE_UNSUPPORTED,
# because that kind of credential has to be sent as an Authorization: Bearer
# header instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: a cheaper model for the simple jobs (review replies, the
# connectivity test). config/ai_guard.php routes those here and falls back to
# GEMINI_MODEL automatically if this model is rejected, so it is safe to try.
# Leave blank to use GEMINI_MODEL for everything.
GEMINI_MODEL_CHEAP=

# ---------------------------------------------------------------------------
# AI cost controls - config/ai_guard.php
#
# Every value below is optional; the defaults shown are what the code uses if
# the variable is absent. These are the only thing standing between a bug or a
# bot and your Gemini bill, so read them before raising any of them.
# ---------------------------------------------------------------------------

# --- Prices, in USD per 1,000,000 tokens ---
# EVERY cost figure in this system - the caps, the alerts, the owner dashboard,
# the growth projection - is computed from these two numbers. Check them
# against https://ai.google.dev/pricing for the model you actually run.
# AI_PRICE_INPUT_PER_M=0.30
# AI_PRICE_OUTPUT_PER_M=2.50

# --- Spend caps (USD). The real ceiling on the bill. ---
# Reaching one does not break the store: AI requests are refused with a clear
# message and the AI Builder falls back to its deterministic engine.
# AI_USER_DAILY_USD=0.25
# AI_GLOBAL_DAILY_USD=3.00
# AI_GLOBAL_MONTHLY_USD=40.00

# --- Rate limits (request counts) ---
# AI_RATE_PER_MIN=3
# AI_RATE_PER_HOUR=15
# AI_RATE_PER_DAY=40
# AI_GLOBAL_CALLS_PER_DAY=400

# --- Retries and loop protection ---
# AI_MAX_ATTEMPTS is TOTAL attempts, not extra retries: 2 = one try plus one
# retry, and only for transient failures (429 / 5xx / timeout). Hard-capped at
# 3 in code whatever is set here.
# AI_MAX_ATTEMPTS=2
# Ceiling on AI calls within a single HTTP request - the backstop against a
# loop or recursion. Checked before anything else and cannot be bypassed.
# AI_MAX_CALLS_PER_REQUEST=3

# --- Alerting ---
# Notify the owner (in-app notification + error log) once the day crosses this
# fraction of a cap. 0.7 = warn at 70%.
# AI_ALERT_AT_PCT=0.7

# Peso conversion used by the Owner Panel's AI Usage page for display only.
# USD_TO_PHP=58

# ==========================================================
# Timezone
# ==========================================================
# The store's own timezone, used for every PHP-side date. Defaults to
# Asia/Manila; config/env.php pins it so PHP's date() agrees with MySQL's
# NOW() instead of inheriting php.ini (XAMPP ships Europe/Berlin, which left
# PHP six hours behind the database). Must be a PHP timezone identifier.
# APP_TIMEZONE=Asia/Manila

# ==========================================================
# Google Sign-In (the "Continue with Google" button)
# ==========================================================
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (it looks like 1234567890-abc123.apps.googleusercontent.com - the client ID is
# public by design, but it is kept here so each machine can point at its own
# project). Read server-side by public/guest/google_auth.php and
# public/shared/includes/auth-modal.php; when it is blank the Google button
# simply does not render and email/password sign-in still works.
GOOGLE_CLIENT_ID=

# ==========================================================
# Outgoing email (PHPMailer) - FALLBACK ONLY
# ==========================================================
# config/functions.php prefers the email_settings row the Owner Panel manages
# in the database (getActiveEmailSettings()); these are only used when no
# active row exists. Leave the block empty to let PHP's mail() handle it.
# For Gmail use an App Password, never the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DEBUG=0
# SMTP_ALLOW_SELF_SIGNED=0
# MAIL_FROM=no-reply@techworld.local
# MAIL_FROM_NAME=TechWorld
